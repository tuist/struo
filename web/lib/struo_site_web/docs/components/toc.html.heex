<aside id="docs-toc" aria-label="Table of contents">
  <div data-part="toc-header">On this page</div>
  <ul data-part="list">
    <li :for={heading <- @headings} data-part="item">
      <a href={"##{heading.id}"} data-level={heading.level}>{heading.text}</a>
    </li>
  </ul>
  <div data-part="toc-actions">
    <.copy_page_menu :if={@markdown != ""} id="docs-copy-menu" current_slug={@current_slug} />
  </div>
</aside>
