<nav id="docs-nav" aria-label="Main navigation">
  <div data-part="header">
    <.link navigate="/" data-part="logo-link" aria-label="Struo home">
      <img data-part="logo" src="/images/struo-mark.webp" width="213" height="208" alt="" />
      <span data-part="logo-text">Struo</span>
    </.link>
    <div data-part="tabs" id="docs-nav-tabs">
      <a
        href="/docs/guide/getting-started"
        data-tab="guides"
        aria-current={@tab == :guides && "true"}
      >
        Guide
      </a>
      <a href="/docs/reference" data-tab="reference" aria-current={@tab == :reference && "true"}>
        Reference
      </a>
    </div>
  </div>
  <div data-part="socials">
    <button
      type="button"
      data-part="search-button"
      aria-label="Search the documentation"
      aria-haspopup="dialog"
      aria-controls="docs-search-dialog"
    >
      <.search />
    </button>
    <a
      href="https://github.com/tuist/struo"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      data-part="social-link"
    >
      {Phoenix.HTML.raw(Layouts.social_icon(:github))}
    </a>
    <a
      href="https://discord.gg/fTpB5e3rRp"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Discord"
      data-part="social-link"
    >
      {Phoenix.HTML.raw(Layouts.social_icon(:discord))}
    </a>
  </div>
</nav>
<div id="docs-mobile-menu-bar" role="toolbar" aria-label="Page navigation">
  <button
    type="button"
    data-part="mobile-menu-btn"
    id="docs-mobile-menu-trigger"
    aria-expanded="false"
    aria-controls="docs-sidebar"
    phx-click={
      JS.toggle_attribute({"data-sidebar-open", ""}, to: "body")
      |> JS.toggle_attribute({"data-mobile-open", ""}, to: "#docs-sidebar")
      |> JS.toggle_attribute({"aria-expanded", "true", "false"}, to: "#docs-mobile-menu-trigger")
    }
  >
    <.icon name="menu_3" />
    <span>Menu</span>
  </button>
  <button
    :if={@headings != []}
    type="button"
    data-part="mobile-toc-btn"
    id="docs-mobile-toc-trigger"
    aria-expanded="false"
    aria-controls="docs-mobile-toc"
    phx-click={
      JS.toggle_attribute({"data-state", "open", "closed"}, to: "#docs-mobile-toc")
      |> JS.toggle_attribute({"aria-expanded", "true", "false"}, to: "#docs-mobile-toc-trigger")
    }
  >
    <span>On this page</span>
    <.icon name="news" />
  </button>
</div>
<div
  id="docs-mobile-sidebar-overlay"
  role="presentation"
  phx-click={close_mobile_navigation()}
>
</div>
<main id="docs-page-layout" data-part="page">
  <textarea :if={@markdown != ""} id="docs-page-markdown" hidden readonly>{@markdown}</textarea>
  <div
    :if={@headings != []}
    id="docs-mobile-toc"
    data-state="closed"
    data-part="mobile-toc"
    role="navigation"
    aria-label="Table of contents"
  >
    <.link_button
      label="Return to top"
      variant="primary"
      size="small"
      href="#"
      phx-click={close_mobile_toc()}
    />
    <.line_divider />
    <a
      :for={heading <- @headings}
      href={"##{heading.id}"}
      data-part="mobile-toc-item"
      data-level={heading.level}
      phx-click={close_mobile_toc()}
    >
      {heading.text}
    </a>
  </div>
  <div id="docs-layout">
    <nav id="docs-sidebar" aria-label="Documentation navigation">
      <div data-part="search-trigger">
        <.text_input
          id="docs-search-trigger"
          type="search"
          name="docs-search-trigger"
          placeholder="Search"
          readonly
          aria-label="Search the documentation"
          aria-haspopup="dialog"
          aria-controls="docs-search-dialog"
        >
          <:suffix>
            <.shortcut_key size="small"><span data-part="search-shortcut"></span></.shortcut_key>
          </:suffix>
        </.text_input>
      </div>
      <div data-part="sidebar-scroll">
        <div :if={@tab == :guides} data-part="nav-section">
          <.link
            patch="/docs"
            data-part="nav-link"
            data-selected={@current_slug == "/docs"}
            phx-click={close_mobile_navigation()}
          >
            <span data-part="label">Overview</span>
          </.link>
        </div>
        <div :for={group <- @tree} data-part="nav-section">
          <.link
            :if={group.slug}
            patch={group.slug}
            data-part="group-label"
            data-selected={group.slug == @current_slug}
            phx-click={close_mobile_navigation()}
          >
            <span>{group.label}</span>
            <.chevron_right />
          </.link>
          <div :if={!group.slug} data-part="group-label">
            <span>{group.label}</span>
          </div>
          <div :if={group.items != []} data-part="nav-items">
            <.nav_items items={group.items} current_slug={@current_slug} />
          </div>
        </div>
      </div>
    </nav>
    <div id="docs-content">
      <div :if={@markdown != ""} id="docs-mobile-copy" data-part="mobile-copy">
        <.copy_page_menu
          id="docs-mobile-copy-menu"
          current_slug={@current_slug}
          placement="bottom-end"
        />
      </div>
      {render_slot(@inner_block)}
    </div>
    <.toc
      :if={@headings != []}
      headings={@headings}
      current_slug={@current_slug}
      markdown={@markdown}
    />
  </div>
</main>
<.live_component module={StruoSiteWeb.Docs.SearchPalette} id="docs-search" />
